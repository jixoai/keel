{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keel.dev/schemas/plugin-market-catalog-1.json",
  "title": "keel.plugin-market.catalog/1",
  "description": "The single machine-readable truth for the DSH/community plugin coverage matrix. Validated by scripts/plugin-catalog.mjs; see docs/PLUGIN-CATALOG.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generatedAt", "sources", "entries", "retiredIds"],
  "properties": {
    "schema": { "const": "keel.plugin-market.catalog/1" },
    "generatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["kind"],
        "properties": {
          "kind": { "enum": ["dsh-official", "dsh-community", "keel-coverage"] },
          "repo": { "type": "string" },
          "ref": { "type": "string" },
          "refDate": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    },
    "retiredIds": {
      "type": "array",
      "items": { "$ref": "#/$defs/retired" }
    }
  },
  "$defs": {
    "wave": { "enum": ["W0.5", "W1", "W2", "W3", "never"] },
    "status": { "enum": ["delivered", "partial", "planned", "registered", "merged", "absent"] },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "summary", "capabilities", "source", "dshPackages", "wave", "dshGroups", "coverage"],
      "properties": {
        "id": { "type": "string", "minLength": 3, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "capabilities": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "source": {
          "type": "object",
          "additionalProperties": true,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["dsh-official", "dsh-community", "keel-official"] },
            "repo": { "type": "string" },
            "url": { "type": "string" },
            "path": { "type": "string" },
            "stars": { "type": "integer", "minimum": 0 },
            "starsObservedAt": { "type": "string" },
            "discovery": { "type": "string" }
          }
        },
        "dshPackages": { "type": "array", "items": { "type": "string" } },
        "wave": { "$ref": "#/$defs/wave" },
        "dshGroups": {
          "type": "array",
          "items": { "type": "string", "pattern": "^dsh\\.[a-z0-9-]+$" }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["covered", "status", "keelPluginId", "tools"],
          "properties": {
            "covered": { "type": "boolean" },
            "status": { "$ref": "#/$defs/status" },
            "keelPluginId": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9._-]{1,63}$" },
            "mergedInto": { "type": "string" },
            "tools": { "type": "array", "items": { "type": "string" } },
            "note": { "type": "string" }
          }
        }
      }
    },
    "retired": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "reason"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$" },
        "status": { "enum": ["merged", "absent"] },
        "into": { "type": "string" },
        "reason": { "type": "string", "minLength": 8 }
      }
    }
  }
}
