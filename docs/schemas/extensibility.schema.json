{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keel.dev/schemas/plugin-extensibility-1.json",
  "title": "keel.plugin-extensibility/1",
  "description": "Machine-readable extension-surface document shipped by a plugin as extensibility.json. The executable validator is internal/pluginpkg/extensibility.go (strict unknown-field rejection); this schema mirrors its rules for tooling and editors. Contract: docs/PLUGIN-EXTENSIBILITY.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "plugin", "version", "summary", "slots", "contributes", "configuration", "hooks", "providers", "examples", "limits"],
  "properties": {
    "schema": { "const": "keel.plugin-extensibility/1" },
    "plugin": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+].*)?$" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "slots": { "type": "array", "items": { "$ref": "#/$defs/slot" } },
    "contributes": { "type": "array", "items": { "$ref": "#/$defs/contribution" } },
    "configuration": { "type": "array", "items": { "$ref": "#/$defs/config" } },
    "hooks": { "type": "array", "items": { "$ref": "#/$defs/hook" } },
    "providers": { "type": "array", "items": { "$ref": "#/$defs/provider" } },
    "examples": { "type": "array", "items": { "$ref": "#/$defs/example" } },
    "limits": { "type": "array", "items": { "$ref": "#/$defs/limit" } }
  },
  "$defs": {
    "form": { "enum": ["chunk", "package", "iframe", "data"] },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "forms", "arity", "targets"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$" },
        "forms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/form" } },
        "arity": { "enum": ["single", "multi", "ordered"] },
        "targets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["web", "native", "tui"] } },
        "schema": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "forms": { "contains": { "const": "data" } } }, "required": ["forms"] },
          "then": { "required": ["schema"] }
        }
      ]
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "form"],
      "properties": {
        "slot": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$" },
        "form": { "$ref": "#/$defs/form" },
        "entry": { "type": "string", "minLength": 1 },
        "payload": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "form": { "enum": ["chunk", "package", "iframe"] } }, "required": ["form"] },
          "then": { "required": ["entry"], "not": { "required": ["payload"] } }
        },
        {
          "if": { "properties": { "form": { "const": "data" } }, "required": ["form"] },
          "then": { "required": ["payload"], "not": { "required": ["entry"] } }
        }
      ]
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "description"],
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
        "type": { "enum": ["string", "integer", "number", "boolean", "string_list", "object"] },
        "required": { "type": "boolean" },
        "default": {},
        "secret": { "type": "boolean" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "description"],
      "properties": {
        "event": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "description"],
      "properties": {
        "port": { "type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,127}$" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "snippet": { "type": "string" }
      }
    },
    "limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "description"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$" },
        "value": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
