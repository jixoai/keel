{
  "name": "Keel",
  "id": "com.fde2e.keel",
  "version": "0.1.0",
  "build": 1,
  "appearance": "dark",
  "theme": "theme.json",
  "capabilities": {
    "network": {
      "hosts": [
        "*"
      ]
    },
    "webview": {
      "hosts": [
        "*"
      ]
    },
    "openUrl": {
      "schemes": [
        "https",
        "http"
      ]
    },
    "host": [
      "keel.*"
    ],
    "clipboard": true,
    "picker": true,
    "speech": true,
    "notifications": true
  },
  "web": {
    "base": "/",
    "host": "./host.js"
  },
  "icon": "icon.png"
}
