{
  "name": "Keel",
  "id": "com.fde2e.keel",
  "version": "0.4.0",
  "build": 5,
  "appearance": "dark",
  "theme": "theme.json",
  "capabilities": {
    "network": {
      "hosts": [
        "*"
      ]
    },
    "webview": {
      "hosts": [
        "*"
      ]
    },
    "openUrl": {
      "schemes": [
        "https",
        "http"
      ]
    },
    "host": [
      "keel.*"
    ],
    "audio": true,
    "clipboard": true,
    "picker": true,
    "speech": true,
    "notifications": true
  },
  "web": {
    "base": "/",
    "host": "./host.js"
  },
  "icon": "icon.png",
  "singleInstance": true,
  "schemes": [
    "keel"
  ],
  "dependencies": {
    "nsh-extra": {
      "version": "^0.7.1",
      "features": [
        "speech"
      ]
    }
  }
}
